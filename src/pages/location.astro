---
import Layout from '../layouts/Layout.astro';
import { business } from '../data';
---

<Layout title="Location — Print 404" active="Location">
  <section class="page">
    <div class="container">
      <div class="page-head">
        <h1>Find Us</h1>
        <p>{business.address}</p>
      </div>
      <div class="location-grid">
        <div class="map-embed">
          <iframe
            title="Print 404 location map"
            src={`https://www.openstreetmap.org/export/embed.html?bbox=${business.lng - 0.01}%2C${business.lat - 0.008}%2C${business.lng + 0.01}%2C${business.lat + 0.008}&layer=mapnik&marker=${business.lat}%2C${business.lng}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <aside class="hours">
          <h3>Opening Hours</h3>
          <ul>
            {business.hours.map((h) => (
              <li><span>{h.day}</span><span>{h.time}</span></li>
            ))}
          </ul>
          <a href={business.mapsUrl} target="_blank" rel="noopener" class="btn btn-block">Open in Google Maps</a>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .location-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }
  .map-embed {
    overflow: hidden;
    border: 2px solid var(--c-text-strong);
    box-shadow: 6px 6px 0 var(--c-border-strong);
    height: 360px;
    background: var(--c-surface-2);
  }
  .map-embed iframe { width: 100%; height: 100%; border: 0; display: block; filter: grayscale(1) contrast(1.05); }
  .hours {
    background: var(--c-surface);
    border: 2px solid var(--c-text-strong);
    box-shadow: 6px 6px 0 var(--c-border-strong);
    padding: 20px;
  }
  .hours h3 { margin: 0 0 12px; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-text-strong); }
  .hours ul { list-style: none; padding: 0; margin: 0; }
  .hours li {
    display: flex; justify-content: space-between; gap: 12px;
    padding: 8px 0; border-bottom: 1px dashed var(--c-border-strong); font-size: 0.85rem;
  }
  .hours li:last-child { border-bottom: 0; }
  .hours li span:last-child { color: var(--c-muted); }
  @media (max-width: 760px) { .location-grid { grid-template-columns: 1fr; } }
</style>
