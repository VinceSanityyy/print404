---
import Layout from '../layouts/Layout.astro';
import { services } from '../data';
---

<Layout title="Services — Print 404" active="Services">
  <section class="page">
    <div class="container">
      <div class="page-head">
        <h1>Our Services</h1>
        <p>Everything you need for documents, printing, and internet access — all in one place.</p>
      </div>
      <div class="grid">
        {services.map((s) => (
          <article class="card">
            <div class="card-icon">{s.icon}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
  .card {
    background: var(--c-surface);
    border: 2px solid var(--c-text-strong);
    padding: 24px 20px;
    transition: transform .12s, box-shadow .12s, background .12s;
    box-shadow: 4px 4px 0 var(--c-border-strong);
  }
  .card:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--c-text-strong); background: var(--c-surface-2); }
  .card-icon { font-size: 1.9rem; margin-bottom: 10px; filter: grayscale(1); }
  .card h3 { margin: 0 0 8px; font-size: 1.1rem; color: var(--c-text-strong); text-transform: uppercase; letter-spacing: 0.03em; }
  .card p { margin: 0; color: var(--c-muted); font-size: 0.9rem; }
</style>
