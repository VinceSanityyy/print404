---
import { business, navItems } from '../data';

interface Props {
  title?: string;
  active?: string;
}

const { title = business.name, active = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/jpeg" href="/logo.jpg" />
  <meta name="description" content={business.tagline} />
  <meta name="keywords" content="printing, internet cafe, photocopy, Bunawan, Agusan del Sur, Print404" />
  <meta property="og:title" content={business.name} />
  <meta property="og:description" content={business.tagline} />
  <meta property="og:image" content="/logo.jpg" />
  <meta property="og:type" content="website" />
  <script is:inline>
    (function () {
      try {
        var savedTheme = localStorage.getItem('print404-theme');
        var theme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      } catch (_) {}
    })();
  </script>
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">
        <img src="/logo.jpg" alt="Print 404 logo" class="brand-logo" width="48" height="48" />
        <span class="brand-name">PRINT<span class="accent">404</span></span>
      </a>
      <div class="header-actions">
        <nav class="nav">
          {navItems.map((item) => (
            <a href={item.href} class={active === item.label ? 'active' : ''}>{item.label}</a>
          ))}
        </nav>
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch theme" aria-pressed="false">
          <span class="theme-toggle-track" aria-hidden="true">
            <span class="theme-toggle-thumb"></span>
          </span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} {business.name}. All rights reserved.</p>
      <p class="muted">Purok 2, San Teodoro, Bunawan, 8506 Agusan del Sur</p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var storageKey = 'print404-theme';
      var root = document.documentElement;
      var toggle = document.getElementById('themeToggle');
      if (!toggle) return;

      function setTheme(theme) {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        localStorage.setItem(storageKey, theme);
        toggle.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
        toggle.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
      }

      setTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
      toggle.addEventListener('click', function () {
        setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    })();
  </script>

  <style is:global>
    :root {
      --c-bg: #f7f7f7;
      --c-surface: #ffffff;
      --c-surface-2: #efefef;
      --c-text: #2a2a2a;
      --c-text-strong: #1a1a1a;
      --c-muted: #6b6b6b;
      --c-border: #d8d8d8;
      --c-border-strong: #b5b5b5;
      --c-grid: rgba(0, 0, 0, 0.025);
      --maxw: 1080px;
      font-family: 'SFMono-Regular', 'Consolas', 'Liberation Mono', 'Menlo', monospace;
    }
    :root[data-theme="dark"] {
      --c-bg: #111111;
      --c-surface: #1a1a1a;
      --c-surface-2: #252525;
      --c-text: #e5e5e5;
      --c-text-strong: #ffffff;
      --c-muted: #ababab;
      --c-border: #333333;
      --c-border-strong: #737373;
      --c-grid: rgba(255, 255, 255, 0.045);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--c-bg);
      color: var(--c-text);
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-image:
        linear-gradient(var(--c-grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--c-grid) 1px, transparent 1px);
      background-size: 32px 32px;
    }
    main { flex: 1; }
    a { color: inherit; text-decoration: none; }
    img, svg, iframe { max-width: 100%; }
    button, input, textarea, select { font: inherit; }
    .accent {
      color: var(--c-text);
      background: var(--c-surface-2);
      padding: 0 6px;
      border: 2px solid var(--c-text-strong);
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
    }
    .container { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 20px; }

    /* Header */
    .site-header {
      position: sticky; top: 0; z-index: 50;
      background: var(--c-bg);
      border-bottom: 2px solid var(--c-text-strong);
    }
    .header-inner {
      display: flex; align-items: center; justify-content: space-between;
      min-height: 60px;
      gap: 18px;
    }
    .brand { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
    .brand-logo {
      filter: grayscale(1) contrast(1.05);
      object-fit: cover;
      border: 2px solid var(--c-text-strong);
    }
    .brand-name { font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; }
    .header-actions { display: flex; align-items: center; gap: 18px; }
    .nav { display: flex; gap: 18px; align-items: center; }
    .nav a {
      color: var(--c-muted); font-size: 0.85rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.04em; transition: color .15s;
      padding: 10px 2px; border-bottom: 2px solid transparent;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
    .nav a:hover { color: var(--c-text-strong); }
    .nav a.active { color: var(--c-text-strong); border-bottom-color: var(--c-text-strong); }
    .theme-toggle {
      width: 62px;
      min-height: 34px;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
      flex: 0 0 auto;
    }
    .theme-toggle-track {
      position: relative;
      display: block;
      width: 62px;
      height: 34px;
      border: 2px solid var(--c-text-strong);
      border-radius: 999px;
      background: linear-gradient(135deg, var(--c-surface), var(--c-surface-2));
      box-shadow: 3px 3px 0 var(--c-border-strong), inset 0 0 0 2px rgba(255,255,255,0.28);
      transition: background .18s, box-shadow .08s, transform .08s;
    }
    :root[data-theme="dark"] .theme-toggle-track {
      background: linear-gradient(135deg, #2b2b2b, #0f0f0f);
      box-shadow: 3px 3px 0 var(--c-border-strong), inset 0 0 0 2px rgba(255,255,255,0.08);
    }
    .theme-toggle:hover .theme-toggle-track { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--c-border-strong), inset 0 0 0 2px rgba(255,255,255,0.18); }
    .theme-toggle:focus-visible { outline: 3px solid var(--c-border-strong); outline-offset: 3px; }
    .theme-toggle-thumb {
      position: absolute;
      top: 4px;
      left: 4px;
      width: 22px;
      height: 22px;
      border: 2px solid var(--c-text-strong);
      border-radius: 50%;
      background: var(--c-bg);
      box-shadow: 1px 1px 0 var(--c-border-strong), 0 2px 8px rgba(0,0,0,0.14);
      transition: transform .2s cubic-bezier(.2,.8,.2,1), background .18s;
    }
    :root[data-theme="dark"] .theme-toggle-thumb { transform: translateX(28px); background: var(--c-text-strong); }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--c-text-strong); color: var(--c-bg);
      min-height: 44px;
      padding: 10px 22px; border-radius: 0;
      font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em;
      border: 2px solid var(--c-text-strong);
      box-shadow: 3px 3px 0 var(--c-border-strong);
      transition: transform .08s, box-shadow .08s;
      cursor: pointer;
    }
    .btn:hover { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--c-border-strong); }
    .btn:active { transform: translate(3px, 3px); box-shadow: 0 0 0 var(--c-border-strong); }
    .btn-ghost {
      background: transparent; color: var(--c-text-strong);
      box-shadow: 3px 3px 0 var(--c-border-strong);
    }
    .btn-ghost:hover { background: var(--c-surface-2); }
    .btn-block { width: 100%; margin-top: 18px; }
    .btn-lg { padding: 13px 28px; font-size: 0.95rem; }

    /* Page sections */
    .page { padding: 60px 0; }
    .page-head { margin-bottom: 44px; text-align: center; }
    .page-head h1 {
      font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0 0 8px;
      letter-spacing: -0.01em; font-weight: 800; color: var(--c-text-strong);
      text-transform: uppercase;
    }
    .page-head p { color: var(--c-muted); max-width: 620px; margin: 0 auto; }

    /* Footer */
    .site-footer { border-top: 2px solid var(--c-text-strong); padding: 32px 0; text-align: center; }
    .site-footer p { margin: 4px 0; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .muted { color: var(--c-muted); }

    /* Responsive */
    @media (max-width: 820px) {
      .site-header { position: static; }
      .header-inner {
        align-items: stretch;
        flex-direction: column;
        gap: 10px;
        padding-top: 10px;
        padding-bottom: 8px;
      }
      .brand { justify-content: center; }
      .brand-logo { width: 42px; height: 42px; }
      .header-actions {
        width: 100%;
        align-items: stretch;
        flex-direction: column;
        gap: 8px;
      }
      .nav {
        width: 100%;
        gap: 6px;
        justify-content: flex-start;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        padding-bottom: 4px;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
      }
      .nav::-webkit-scrollbar { display: none; }
      .nav a {
        flex: 0 0 auto;
        font-size: 0.73rem;
        padding: 8px 9px;
        border: 1px solid var(--c-border-strong);
        background: var(--c-surface);
      }
      .nav a.active {
        color: var(--c-bg);
        background: var(--c-text-strong);
        border-color: var(--c-text-strong);
      }
      .theme-toggle { align-self: center; width: 62px; min-height: 38px; }
      .theme-toggle-track { width: 62px; height: 34px; }
      .theme-toggle-thumb { top: 4px; left: 4px; }
      :root[data-theme="dark"] .theme-toggle-thumb { transform: translateX(28px); }
    }

    @media (max-width: 560px) {
      .container { padding: 0 14px; }
      .page { padding: 34px 0; }
      .page-head { margin-bottom: 26px; }
      .page-head h1 { font-size: clamp(1.55rem, 10vw, 2.15rem); }
      .page-head p { font-size: 0.92rem; }
      .btn { width: 100%; padding-inline: 14px; text-align: center; }
      .btn-lg { padding-block: 12px; font-size: 0.82rem; }
      .site-footer { padding: 24px 0; }
      .site-footer p { font-size: 0.72rem; }
    }
  </style>
</body>
</html>
